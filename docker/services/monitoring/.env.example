GRAFANA_DOMAIN=grafana.example.com
MIMIR_DOMAIN=mimir.example.com
LOKI_DOMAIN=loki.example.com

# Plaintext push token — set this same value on each observer node as NODE_PUSH_TOKEN
MIMIR_PUSH_TOKEN=change-me

# Bcrypt hash of the token above lives on the host, mounted into the traefik
# container at /etc/traefik (see docker-compose.yml's volumes) — not tracked
# in this repo. Regenerate with: docker run --rm httpd:alpine htpasswd -nbB nodes <new-token>
