# Адрес/хост, который брокер объявляет внешним клиентам (хост-машина,
# другой сервер) после подключения к внешнему листенеру (порт 19092).
# Для локального теста — localhost. Для доступа с другой машины — реальный
# IP/домен этой машины.
KAFKA_ADVERTISED_HOST=127.0.0.1

# Логин/пароль веб-панели (Redpanda Console) на :8081 — защищена nginx
# Basic Auth, т.к. сама консоль в open-source версии без логина вообще.
# Пароль тут только для памяти — реальную проверку делает .htpasswd
# (пересоздаётся из этих двух переменных при каждом старте контейнера).
KAFKA_CONSOLE_USER=admin
KAFKA_CONSOLE_PASSWORD=change-me
