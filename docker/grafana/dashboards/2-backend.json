{
  "title": "Backend — App & Database",
  "uid": "rcagent-backend",
  "tags": ["rcagent", "backend"],
  "timezone": "browser",
  "refresh": "15s",
  "schemaVersion": 38,
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Request Rate",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [{ "expr": "sum(rate(http_requests_total{job=\"backend\"}[2m]))", "legendFormat": "req/s" }]
    },
    {
      "id": 2, "type": "stat", "title": "Error Rate (5xx)",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "reqps", "thresholds": { "mode": "absolute", "steps": [{"value": 0, "color": "green"}, {"value": 0.01, "color": "red"}] } } },
      "targets": [{ "expr": "sum(rate(http_requests_total{job=\"backend\",status=~\"5..\"}[2m]))", "legendFormat": "5xx/s" }]
    },
    {
      "id": 3, "type": "stat", "title": "P95 Latency",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{"value": 0, "color": "green"}, {"value": 0.5, "color": "yellow"}, {"value": 1, "color": "red"}] } } },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by(le) (rate(http_request_duration_seconds_bucket{job=\"backend\"}[2m])))", "legendFormat": "p95" }]
    },
    {
      "id": 4, "type": "stat", "title": "Jobs Dispatched",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [{ "expr": "increase(scheduler_jobs_dispatched_total{job=\"backend\"}[5m])", "legendFormat": "last 5m" }]
    },
    {
      "id": 5, "type": "stat", "title": "Observations Received",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [{ "expr": "increase(consumer_observations_received_total{job=\"backend\"}[5m])", "legendFormat": "last 5m" }]
    },
    {
      "id": 6, "type": "stat", "title": "Open Incidents",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{"value": 0, "color": "green"}, {"value": 1, "color": "red"}] } } },
      "targets": [{ "expr": "increase(incidents_opened_total{job=\"backend\"}[1h]) - increase(incidents_recovered_total{job=\"backend\"}[1h])", "legendFormat": "open" }]
    },
    {
      "id": 7, "type": "timeseries", "title": "HTTP Request Rate by Status",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        { "expr": "sum by(status) (rate(http_requests_total{job=\"backend\"}[2m]))", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 8, "type": "timeseries", "title": "HTTP Latency Percentiles",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by(le,path) (rate(http_request_duration_seconds_bucket{job=\"backend\"}[2m])))", "legendFormat": "p50 {{path}}" },
        { "expr": "histogram_quantile(0.95, sum by(le,path) (rate(http_request_duration_seconds_bucket{job=\"backend\"}[2m])))", "legendFormat": "p95 {{path}}" },
        { "expr": "histogram_quantile(0.99, sum by(le,path) (rate(http_request_duration_seconds_bucket{job=\"backend\"}[2m])))", "legendFormat": "p99 {{path}}" }
      ]
    },
    {
      "id": 9, "type": "timeseries", "title": "Postgres — Active Connections",
      "gridPos": { "x": 0, "y": 12, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        { "expr": "pg_stat_activity_count{job=\"postgres\",state=\"active\"}", "legendFormat": "active" },
        { "expr": "pg_stat_activity_count{job=\"postgres\",state=\"idle\"}", "legendFormat": "idle" }
      ]
    },
    {
      "id": 10, "type": "timeseries", "title": "Postgres — Transactions/s",
      "gridPos": { "x": 8, "y": 12, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        { "expr": "sum(rate(pg_stat_database_xact_commit_total{job=\"postgres\"}[2m]))", "legendFormat": "commit/s" },
        { "expr": "sum(rate(pg_stat_database_xact_rollback_total{job=\"postgres\"}[2m]))", "legendFormat": "rollback/s" }
      ]
    },
    {
      "id": 11, "type": "timeseries", "title": "Postgres — DB Size",
      "gridPos": { "x": 16, "y": 12, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        { "expr": "pg_database_size_bytes{job=\"postgres\"}", "legendFormat": "{{datname}}" }
      ]
    },
    {
      "id": 12, "type": "timeseries", "title": "Container CPU — Backend",
      "gridPos": { "x": 0, "y": 19, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "targets": [
        { "expr": "rate(container_cpu_usage_seconds_total{job=\"cadvisor\",name=~\".*app.*|.*backend.*|.*db.*|.*kafka.*|.*rabbitmq.*\"}[2m]) * 100", "legendFormat": "{{name}}" }
      ]
    },
    {
      "id": 13, "type": "timeseries", "title": "Container Memory — Backend",
      "gridPos": { "x": 12, "y": 19, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        { "expr": "container_memory_working_set_bytes{job=\"cadvisor\",name=~\".*app.*|.*backend.*|.*db.*|.*kafka.*|.*rabbitmq.*\"}", "legendFormat": "{{name}}" }
      ]
    },
    {
      "id": 14, "type": "logs", "title": "Backend Logs",
      "gridPos": { "x": 0, "y": 26, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "sortOrder": "Descending", "wrapLogMessage": false },
      "targets": [{ "expr": "{job=~\"docker/.*app.*\"}", "legendFormat": "" }]
    }
  ]
}
