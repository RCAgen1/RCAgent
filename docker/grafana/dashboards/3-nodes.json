{
  "title": "Nodes — Observer Fleet",
  "uid": "rcagent-nodes",
  "tags": ["rcagent", "nodes"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 38,
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "node_id",
        "type": "query",
        "label": "Node",
        "multi": true,
        "includeAll": true,
        "datasource": { "type": "prometheus", "uid": "mimir" },
        "query": { "query": "label_values(up{job=\"node\"}, node_id)", "refId": "A" },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Nodes Online",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{"value": 0, "color": "red"}, {"value": 1, "color": "green"}] } } },
      "targets": [{ "expr": "count(time() - timestamp(last_over_time(up{job=\"node\"}[5m])) < 120)", "legendFormat": "online" }]
    },
    {
      "id": 2, "type": "stat", "title": "Nodes Offline (>2m)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{"value": 0, "color": "green"}, {"value": 1, "color": "red"}] } } },
      "targets": [{ "expr": "count(time() - timestamp(last_over_time(up{job=\"node\"}[5m])) >= 120) or vector(0)", "legendFormat": "offline" }]
    },
    {
      "id": 3, "type": "table", "title": "Node Status",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "options": { "sortBy": [{"displayName": "Last Seen", "desc": true}] },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "Status" }, "properties": [{ "id": "custom.displayMode", "value": "color-background" }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{"value": 0, "color": "red"}, {"value": 1, "color": "green"}] } }] }
        ]
      },
      "targets": [{ "expr": "time() - timestamp(last_over_time(up{job=\"node\",node_id=~\"$node_id\"}[5m]))", "legendFormat": "{{node_id}} ({{region}})", "instant": true }],
      "transformations": [
        { "id": "labelsToFields", "options": { "valueLabel": "node_id" } },
        { "id": "organize", "options": { "renameByName": { "Value": "Last Seen (s ago)" } } }
      ]
    },
    {
      "id": 4, "type": "timeseries", "title": "CPU Usage — $node_id",
      "gridPos": { "x": 0, "y": 10, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "repeat": "node_id",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "targets": [
        { "expr": "(1 - avg by(node_id) (rate(node_cpu_seconds_total{job=\"node\",mode=\"idle\",node_id=~\"$node_id\"}[2m]))) * 100", "legendFormat": "{{node_id}}" }
      ]
    },
    {
      "id": 5, "type": "timeseries", "title": "Memory Usage — $node_id",
      "gridPos": { "x": 12, "y": 10, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "repeat": "node_id",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "targets": [
        { "expr": "(1 - node_memory_MemAvailable_bytes{job=\"node\",node_id=~\"$node_id\"} / node_memory_MemTotal_bytes{job=\"node\",node_id=~\"$node_id\"}) * 100", "legendFormat": "{{node_id}}" }
      ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Network — $node_id",
      "gridPos": { "x": 0, "y": 18, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "repeat": "node_id",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "targets": [
        { "expr": "rate(node_network_receive_bytes_total{job=\"node\",node_id=~\"$node_id\",device!~\"lo\"}[2m])", "legendFormat": "↓ rx" },
        { "expr": "rate(node_network_transmit_bytes_total{job=\"node\",node_id=~\"$node_id\",device!~\"lo\"}[2m])", "legendFormat": "↑ tx" }
      ]
    },
    {
      "id": 7, "type": "timeseries", "title": "Disk Usage — $node_id",
      "gridPos": { "x": 12, "y": 18, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "repeat": "node_id",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "targets": [
        { "expr": "(1 - node_filesystem_avail_bytes{job=\"node\",node_id=~\"$node_id\",mountpoint=\"/\",fstype!=\"tmpfs\"} / node_filesystem_size_bytes{job=\"node\",node_id=~\"$node_id\",mountpoint=\"/\",fstype!=\"tmpfs\"}) * 100", "legendFormat": "disk /" }
      ]
    }
  ]
}
