# ── Stage 1: сборка ──────────────────────────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app

# Копируем только манифест зависимостей — слой кешируется пока package.json не изменится
COPY package.json package-lock.json ./
RUN npm ci

# Копируем исходники и собираем статику в /app/dist
COPY . .
RUN npm run build

# ── Stage 2: раздача статики через nginx ──────────────────────────────────────
FROM nginx:alpine

# Кладём собранный dist в стандартную папку nginx
COPY --from=build /app/dist /usr/share/nginx/html

# Порт 80 — стандартный HTTP внутри контейнера.
# Снаружи маппится в docker-compose: "3000:80" → localhost:3000
EXPOSE 80

# Если нужен кастомный nginx.conf (proxy к backend, SPA fallback) — раскомментируй:
# COPY nginx.conf /etc/nginx/conf.d/default.conf

CMD ["nginx", "-g", "daemon off;"]
